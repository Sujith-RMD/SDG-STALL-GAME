# Upstash Redis (REST) — server-side only, NEVER exposed to frontend JavaScript.
# 1. Create a free database at https://console.upstash.com (Redis, any region close to your players).
# 2. Easiest: in Vercel, Project -> Storage -> add the Upstash Redis Marketplace integration,
#    which injects these two variables automatically.
#    Manual alternative: Vercel Project -> Settings -> Environment Variables ->
#    add UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN from the Upstash console
#    (REST section: UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN).
# 3. For local testing with `vercel dev`, copy the same two values into a file named
#    .env.local in this folder (git-ignored — do not commit real tokens).

UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-write-token

# Admin leaderboard trim — POST /api/admin/trim-leaderboard
# OPTIONAL. If this is unset (or shorter than 24 characters) the route refuses
# to run and answers 503 — it fails closed, because it deletes rows.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TRIM_TOKEN=

# How many leaderboard entries the trim keeps. Default 3.
LEADERBOARD_KEEP=3

# Per-IP request budget for the admin trim route. Default 10.
RATE_LIMIT_ADMIN_TRIM_PER_MIN=10
